# Copy to .env.local and adjust. The defaults work with `fastapi dev main.py`.

# Where the FastAPI backend is running. Used by the Vite dev proxy.
# VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# Base path the frontend calls. Keep /api in development so the dev proxy
# handles it; point it straight at the backend origin for a static build.
# VITE_API_BASE_URL=/api
